# Discord Bot Configuration
# Copy this file to .env and fill in your actual values

DISCORD_TOKEN=your_discord_bot_token_here
SPACETIME_URL=ws://localhost:3000

# Log level: info (default), debug (verbose), warn, error
# To hide tick execution and heartbeat logs, keep this at info or warn
# tracing=error suppresses noisy do_heartbeat span logs
RUST_LOG=info,serenity::gateway=error,tracing=error,spacetimedb_sdk=warn
